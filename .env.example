# ===== Intervals.icu =====
# 推荐：直接在 App「设置」页填写 ICU API Key（存手机浏览器本地，改起来方便）。
# 下面的服务器变量作为兜底：页面没填时才使用。
ICU_API_KEY=

# 运动员 ID（个人主页 URL 里的数字，如 i464783 → 464783）
# 也可在 App「设置」页填写；两者都填时以页面为准；都留空则用 Key 所属账号
ICU_ATHLETE_ID=

# ===== AI 模型（可替换；推荐在 App「设置」页填写，只存手机浏览器）=====
# 服务器这里可不填模型配置：App「设置」页选好服务商并填模型 API Key 后，请求会带过来（页面优先）。
# 仅当你想用「定时预生成每日建议」或不想在手机上填时，才需要配在服务器。
# 可选：deepseek | volcano | openai | moonshot | custom
LLM_PROVIDER=deepseek

# 各提供商的 API Key（用哪个填哪个，其余留空即可；页面填的 Key 优先）
DEEPSEEK_API_KEY=
VOLCANO_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
CUSTOM_API_KEY=

# ===== 高级配置（一般不用改）=====
# 覆盖默认 base_url 与模型名；留空则用上面 provider 的默认值
LLM_BASE_URL=
LLM_MODEL=
# custom 类型必填上面两项；volcano 的 LLM_MODEL 填方舟里的“推理接入点 ID”(如 ep-xxx)

# ===== 访问口令（强烈建议填）=====
# 填一串只有你知道的随机字符后，所有接口都会要求请求头带同样的口令——
# 防止陌生人打开你的网页地址后白嫖你的模型额度/读写 ICU。
# App「设置」页的「访问口令」必须填与这里一致的同一个值。
ACCESS_TOKEN=

# ===== 定时任务（可选）=====
# 建议填一串随机字符，Vercel Cron 请求会带这个密钥校验，防止被外人触发
CRON_SECRET=

# ===== 教练长期记忆（可选）=====
# 记忆保留天数（默认 48）；App「设置」页填写的天数优先于此值
MEMORY_DAYS=48
